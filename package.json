{
  "name": "glass-player",
  "version": "0.2.15",
  "description": "Liquid glass music and video player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:portable": "electron-builder --win portable",
    "release": "node scripts/release.js"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@44.10.2": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "music-metadata": "^12.3.4",
    "node-id3": "^0.2.9"
  },
  "productName": "Glassy",
  "build": {
    "appId": "com.glass.player",
    "productName": "Glassy",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "Glassy-${version}-mac-${arch}.${ext}"
    },
    "dmg": { "artifactName": "Glassy-${version}-mac-${arch}.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glassy",
      "artifactName": "Glassy Setup ${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "m4a",
          "flac",
          "wav",
          "ogg",
          "opus"
        ],
        "name": "Audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "m4v",
          "webm",
          "mkv",
          "mov"
        ],
        "name": "Video",
        "role": "Viewer"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pxlarized2",
        "repo": "glass-player",
        "releaseType": "release"
      }
    ]
  }
}
